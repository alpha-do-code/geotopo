# Copier en .env (développement). En production, ces valeurs se règlent chez l'hébergeur.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://UTILISATEUR@localhost:5432/geotopo
# Au moins 32 caractères aléatoires : openssl rand -base64 48
JWT_SECRET=
# Adresse publique du site (CORS, liens des e-mails). En production : https://…
ORIGINE_WEB=http://localhost:3001
