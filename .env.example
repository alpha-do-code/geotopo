# Copier en .env.local. Sans ces deux valeurs, l'application tourne en mode local (sans synchronisation).
# Supabase → Project Settings → API Keys. Clé publique uniquement, jamais la clé secrète.
NEXT_PUBLIC_SUPABASE_URL=https://<ref-du-projet>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
